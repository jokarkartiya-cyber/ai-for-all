# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000

# ─── Database ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_for_all
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Qdrant Vector Database ────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── Authentication ────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── AI Providers ───────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ─── AI Gateway ─────────────────────────────────────────────
AI_GATEWAY_DEFAULT_PROVIDER=openai
AI_GATEWAY_DEFAULT_MODEL=gpt-4o
AI_GATEWAY_FALLBACK_MODEL=gpt-3.5-turbo
AI_GATEWAY_MAX_TOKENS=4096
AI_GATEWAY_TEMPERATURE=0.7

# ─── Code Execution ─────────────────────────────────────────
DOCKER_SANDBOX_IMAGE=sandbox:latest
DOCKER_SANDBOX_TIMEOUT=30000
DOCKER_SANDBOX_MEMORY=512m
DOCKER_SANDBOX_CPU=1

# ─── Storage ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Email (SMTP) ────────────────────────────────────────────
# For Gmail: use an App Password, enable 2FA first
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="ai for all <your@gmail.com>"
# APP_URL=http://localhost:5173
